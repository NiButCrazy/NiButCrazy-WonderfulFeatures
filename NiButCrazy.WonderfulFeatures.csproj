<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0-windows</TargetFramework>
        <UseWPF>true</UseWPF>
        <Nullable>enable</Nullable>
        <LangVersion>14</LangVersion>
        <AssemblyName>PCL.Plugin.NiButCrazy</AssemblyName>
        <RootNamespace>PCL.Plugin.NiButCrazy</RootNamespace>
        <Configurations>Debug;Release</Configurations>
        <Platforms>AnyCPU;x64</Platforms>
        <OutDir>bin\$(Configuration)\</OutDir>
        <!--
            插件需要引用 PCL Nex 的 PCL.Core.dll 与 Plain Craft Launcher 2.dll。
            默认取同级 PCL2-Nex 仓库的 Release/x64 构建产物，
            也可以用 -p:PclBuildDir=<目录> 指向任意一份已构建的启动器输出目录。
        -->
        <PclBuildDir Condition="'$(PclBuildDir)' == ''">$(MSBuildThisFileDirectory)..\PCL2-Nex\Plain Craft Launcher 2\bin\$(Configuration)\net10.0-windows\win-x64</PclBuildDir>
    </PropertyGroup>
    <ItemGroup>
        <Reference Include="PCL.Core">
            <HintPath>$(PclBuildDir)\PCL.Core.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Plain Craft Launcher 2">
            <HintPath>$(PclBuildDir)\Plain Craft Launcher 2.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>
</Project>
